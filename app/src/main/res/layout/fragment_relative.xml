<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="@color/white">

    <!-- TextView Judul -->
    <TextView
        android:id="@+id/tvTitleRelative"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="IMPLEMENTASI RELATIVE"
        android:textColor="@color/black"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center" />

    <!-- TextView Deskripsi (di bawah Judul) -->
    <TextView
        android:id="@+id/tvDescRelative"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvTitleRelative"
        android:layout_marginTop="20dp"
        android:text="Relative Layout merupakan layout yang mengatur tata letak komponen atau UI aplikasi android dengan cara relative (saling menghubungkan antar komponen satu dengan komponen lainnya)."
        android:textColor="@color/black"
        android:textSize="14sp"
        android:gravity="center"
        android:lineSpacingExtra="4dp" />

    <!-- Container Tombol OK dan CANCEL (di bawah Deskripsi) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvDescRelative"
        android:layout_marginTop="32dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnOkRelative"
            style="@style/button_OK_Biru"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="OK" />

        <Button
            android:id="@+id/btnCancelRelative"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/red_cancel"
            android:minHeight="48dp"
            android:text="CANCEL"
            android:textColor="@color/white"
            android:textSize="16sp" />

    </LinearLayout>

</RelativeLayout>